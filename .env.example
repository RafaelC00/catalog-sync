# Copy to .env and fill in. Never commit the real .env file.

DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
DJANGO_CSRF_TRUSTED_ORIGINS=

# Leave unset locally to use SQLite. Required (Postgres) when DJANGO_DEBUG=false.
DATABASE_URL=

CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOW_ALL_ORIGINS=false

SHOPIFY_API_VERSION=2025-01
SHOPIFY_WEBHOOK_SECRET=

# Shared secret the merchant API (/api/merchant/...) requires in the
# X-Merchant-Token header. Leave unset to reject all merchant requests.
MERCHANT_API_TOKEN=

# One SHOPIFY_DOMAIN_<SLUG> / SHOPIFY_TOKEN_<SLUG> pair per store
# registered via `manage.py seed_stores`. Slug is uppercased with
# dashes turned into underscores, e.g. store slug "nomada" reads
# SHOPIFY_DOMAIN_NOMADA and SHOPIFY_TOKEN_NOMADA.
SHOPIFY_DOMAIN_NOMADA=
SHOPIFY_TOKEN_NOMADA=
SHOPIFY_DOMAIN_LOOMWERK=
SHOPIFY_TOKEN_LOOMWERK=
