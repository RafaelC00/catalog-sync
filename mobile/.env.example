EXPO_PUBLIC_STOREFRONT_API_VERSION=2026-01
EXPO_PUBLIC_NOMADA_DOMAIN=your-shop.myshopify.com
EXPO_PUBLIC_NOMADA_STOREFRONT_TOKEN=32-char-storefront-access-token
EXPO_PUBLIC_LOOMWERK_DOMAIN=your-other-shop.myshopify.com
EXPO_PUBLIC_LOOMWERK_STOREFRONT_TOKEN=32-char-storefront-access-token

# Merchant persona backend (see src/api/merchantClient.ts). Defaults to
# localhost:8000 if unset -- the merchant screens handle it being absent,
# unreachable, or rejecting the token as a first-class "unavailable" state.
EXPO_PUBLIC_MERCHANT_API_URL=http://localhost:8000
EXPO_PUBLIC_MERCHANT_API_TOKEN=your-merchant-api-token
